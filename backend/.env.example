PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@heisenberg.dchvcg4.mongodb.net/NeuroNest
JWT_SECRET=replace_with_a_long_random_string

# Gmail SMTP for sending OTP verification emails
# EMAIL_USER = your full gmail address
# EMAIL_PASS = a 16-character Gmail "App Password" (NOT your normal password)
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=youraddress@gmail.com

# Optional: use a generic SMTP server instead of Gmail.
# If EMAIL_HOST is set, EMAIL_PORT/EMAIL_SECURE are used.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Email delivery safety limits (milliseconds)
EMAIL_SEND_TIMEOUT_MS=12000
EMAIL_CONNECTION_TIMEOUT_MS=8000
EMAIL_GREETING_TIMEOUT_MS=8000
EMAIL_SOCKET_TIMEOUT_MS=10000


# Cloudinary (https://cloudinary.com) - for storing uploaded patient records
# Get these from your Cloudinary dashboard home page after signing up (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Timezone used for daily game and reminder schedules
APP_TIMEZONE=Asia/Kolkata

FRONTEND_URL=https://your-frontend-url.vercel.app
