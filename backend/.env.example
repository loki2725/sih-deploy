PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@heisenberg.dchvcg4.mongodb.net/NeuroNest
JWT_SECRET=replace_with_a_long_random_string

# Brevo (https://brevo.com) - sends email over HTTPS instead of SMTP.
# This matters specifically for hosts like Render's free tier, which blocks
# outbound SMTP (ports 25/465/587) - HTTPS (443) is never blocked that way.
#
# 1. Sign up free at brevo.com (300 emails/day, no credit card needed)
# 2. Go to Senders, Domains & Dedicated IPs > Senders > add + verify your
#    sender email (a one-time 6-digit code sent to that address - works
#    fine with a normal Gmail address, no owned domain required)
# 3. Go to Settings > SMTP & API > API Keys > generate a new key
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=youraddress@gmail.com

# Email delivery safety limit (milliseconds)
EMAIL_SEND_TIMEOUT_MS=12000


# Cloudinary (https://cloudinary.com) - for storing uploaded patient records
# Get these from your Cloudinary dashboard home page after signing up (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Timezone used for daily game and reminder schedules
APP_TIMEZONE=Asia/Kolkata

FRONTEND_URL=https://your-frontend-url.vercel.app
